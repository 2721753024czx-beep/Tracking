# Public source allowlist. Everything else stays local, including future folders.
*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/AGENTS.md
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
!/3.0/
!/3.0/app/
!/3.0/app/.gitignore
!/3.0/app/README.md
!/3.0/app/requirements.txt
!/3.0/app/requirements.lock.txt
!/3.0/app/run.sh
!/3.0/app/run-reid.sh
!/3.0/app/tracking3/
!/3.0/app/tracking3/**/
!/3.0/app/tracking3/**/*.py
!/3.0/app/tracking3/vendor/OSNET-LICENSE.txt
!/3.0/app/static/
!/3.0/app/static/*.html
!/3.0/app/static/*.css
!/3.0/app/static/*.js
!/3.0/app/tests/
!/3.0/app/tests/*.py
!/3.0/app/tests/*.cjs
!/3.0/app/tools/
!/3.0/app/tools/*.py
!/3.0/app/models/
!/3.0/app/models/README.md
!/3.0/文档/
!/3.0/文档/开源/
!/3.0/文档/开源/*.md
!/3.0/工具/
!/3.0/工具/sync_github.py

# Local experiment helpers depend on excluded real footage or private examples.
/3.0/app/tests/test_l01_launcher.py
/3.0/app/tools/benchmark_reid.py
/3.0/app/tools/verify_real_entries.py
/3.0/app/tools/prepare_connection_demo.py

# These exclusions apply even inside an otherwise public source directory.
**/__pycache__/
**/.venv/
**/node_modules/
**/.env*
**/*.pyc
**/*.sqlite*
**/*.db
**/*.mp4
**/*.mov
**/*.jpg
**/*.png
**/*.pth
**/*.pt
**/*.onnx
**/.DS_Store
